# Copy to .env (gitignored) and fill in real values.

# WordPress admin account password for ksscca.org (user: Ian@futurehat.com)
WP_PASS=

# WordPress Application Password for REST API writes.
# Users -> Profile -> Application Passwords in wp-admin. Spaces in the value are fine.
# This is what bin/wp-rest uses. Unlocks settings, widgets, plugins, media and content.
WP_APP_PASS=

# WP Engine install name, used for SSH/WP-CLI and the *.wpengine.com hostname
WPE_INSTALL=
