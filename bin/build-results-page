#!/usr/bin/env python3
"""Render a results archive page (year sidebar + per-season event rows) from a JSON file.

    bin/build-results-page results/autocross.json > results/build/autocross.html
    bin/build-results-page --schedule results/autocross.json > results/build/autocross-schedule.html

The JSON shape is documented by example in results/autocross.json and
results/rallycross.json:

    {"page_id": 898, "title": "...", "discipline": "Solo", "intro": "...",
     "seasons": {"2024": [{"title": "...", "date": "...", "links": [["Class", "/..."], ...]}, ...]}}

Seasons render newest first in the sidebar; rows render in the order given
(calendar order, earliest first). Everything is emitted on one line per row
because WordPress's wpautop() wraps an inline element followed by a block in an
empty <p>, which the theme then gives a margin (cost real time once).

The output is the full post_content for the page: <style>, heading, intro,
markup and the small script that switches years. Publish it with
wp_update_page (or bin/wp-rest); it is a plain full-content replacement.
"""

import html
import json
import sys
from datetime import datetime
from pathlib import Path

STYLE = """<style>/* Results archive styles. This comment stays on the same line as the tag on
purpose: a newline straight after <style> lets wpautop insert a <p> that swallows
whatever rule comes first, so the first line is kept expendable. The fonts these
rules use are enqueued in the document head by the ksscca-fonts snippet (#36),
not imported here. */
#ksr-results{font-family:var(--ks-font-body);color:var(--ks-paddock-white);min-width:0;}
#ksr-results p:empty{display:none;margin:0;}
/* The theme repeats the page title above the content; our H1 replaces it.
   No literal tags in these comments: WordPress parses them as real markup. */
body.page-id-PAGE_ID .row.header .title-page{display:none;}
#ksr-results .ksr-layout{display:grid;grid-template-columns:160px 1fr;border:1px solid var(--ks-ground-seam);min-width:0;}
#ksr-results .ksr-years{background:transparent;border-right:1px solid var(--ks-ground-seam);}
#ksr-results .ksr-year-btn{display:block;width:100%;text-align:left;padding:14px 18px;background:none;border:none;border-bottom:1px solid var(--ks-ground-seam);color:var(--ks-morning-mist);font-family:var(--ks-font-display);font-size:19px;font-weight:700;letter-spacing:.02em;cursor:pointer;}
#ksr-results .ksr-year-btn:last-child{border-bottom:none;}
#ksr-results .ksr-year-btn.active{color:var(--ks-paddock-white);background:var(--ks-fog-lift);box-shadow:inset 3px 0 0 var(--ks-grid-light-green);}
#ksr-results .ksr-year-btn:not(.active):hover{color:var(--ks-paddock-white);background:var(--ks-fog-lift);}
#ksr-results .ksr-panel{padding:0;min-width:0;}
#ksr-results .ksr-season{display:none;}
#ksr-results .ksr-season.active{display:block;}
#ksr-results .ksr-season-head{padding:16px 20px;border-bottom:1px solid var(--ks-ground-seam);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ks-morning-mist);}
#ksr-results .ksr-col-head{display:flex;justify-content:space-between;padding:10px 20px;border-bottom:1px solid var(--ks-ground-seam);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ks-morning-mist);}
#ksr-results .ksr-row{display:block;padding:12px 20px;border-bottom:1px solid var(--ks-ground-seam);}
#ksr-results .ksr-row:last-child{border-bottom:none;}
#ksr-results .ksr-row:hover{background:var(--ks-fog-lift);}
#ksr-results .ksr-event-name{display:block;font-weight:600;font-size:14.5px;color:var(--ks-paddock-white);line-height:1.2;margin:0;padding:0;}
#ksr-results .ksr-meta{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-top:1px;line-height:1.2;}
#ksr-results .ksr-event-sub{font-size:12.5px;color:var(--ks-morning-mist);min-width:0;}
#ksr-results .ksr-links{font-size:13px;white-space:nowrap;flex:none;margin-left:auto;}
#ksr-results .ksr-link{color:var(--ks-wheat-gold);text-decoration:none;font-weight:600;}
#ksr-results .ksr-link:hover{color:var(--ks-wheat-gold-bright);text-decoration:underline;}
#ksr-results .ksr-sep{color:var(--ks-seam-quiet);}
#ksr-results .ksr-eyebrow{font-family:var(--ks-font-body) !important;font-size:12px !important;line-height:1.4;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ks-morning-mist);margin:0 0 6px;text-align:left;}
#ksr-results .ksr-h{text-align:left;font-weight:700;margin:0 0 12px;}#ksr-results .ksr-head{display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;}#ksr-results .ksr-head .ksr-h{margin-bottom:12px;}#ksr-results .ksr-btn{display:inline-block;font-family:var(--ks-font-body);font-size:13px;line-height:1;font-weight:700;padding:8px 16px;border-radius:8px;background:transparent;border:1px solid var(--ks-wheat-gold-edge);color:var(--ks-wheat-gold);text-decoration:none;white-space:nowrap;}#ksr-results a.ksr-btn:hover{background:var(--ks-wheat-gold-wash);border-color:var(--ks-wheat-gold-edge-hover);color:var(--ks-wheat-gold-bright);}#ksr-results .ksr-btn.is-off{border-color:var(--ks-ground-seam);color:var(--ks-morning-mist);cursor:not-allowed;}#ksr-results .ksr-prow{display:flex;align-items:center;justify-content:space-between;gap:14px;background:var(--ks-wheat-gold-wash);border-bottom:1px solid var(--ks-ground-seam);}#ksr-results .ksr-prow .ksr-event-name{color:var(--ks-wheat-gold);}#ksr-results .ksr-prow .ksr-meta{margin:0;flex:none;}#ksr-results .ksr-prow .ksr-links{display:flex;gap:8px;}#ksr-results .ksr-prow a.ksr-btn:hover{background:rgba(226,196,124,.2);}
#ksr-results .ksr-intro{text-align:left;color:var(--ks-morning-mist);font-size:13px;margin:0 0 18px;}
#ksr-results .ksr-current{border:1px solid var(--ks-ground-seam);margin-bottom:34px;}
#ksr-results .ksr-na{padding:14px 20px;font-size:13px;color:var(--ks-morning-mist);}
#ksr-results .ksr-pending{color:var(--ks-morning-mist);font-weight:400;font-style:italic;}
#ksr-results .ksr-cal-row{display:flex;align-items:center;gap:14px;}
#ksr-results .ksr-cal{flex:none;width:40px;border:1px solid var(--ks-ground-seam);border-radius:6px;overflow:hidden;text-align:center;line-height:1;}
#ksr-results .ksr-cal-m{display:block;font-size:9.5px;font-weight:700;letter-spacing:.08em;padding:3px 0;background:var(--ks-ground-seam);color:var(--ks-morning-mist);}
#ksr-results .ksr-cal-d{display:block;font-family:var(--ks-font-display);font-size:18px;font-weight:700;padding:3px 0 4px;color:var(--ks-paddock-white);}
#ksr-results .ksr-cal-row.is-upcoming .ksr-cal-m{background:var(--ks-wheat-gold-wash);color:var(--ks-wheat-gold);}
#ksr-results .ksr-cal-main{flex:1;min-width:0;}
#ksr-results .ksr-ds{display:none;}
@media (max-width:700px){
#ksr-results .ksr-layout{grid-template-columns:1fr;}
#ksr-results .ksr-years{display:flex;overflow-x:auto;border-right:none;border-bottom:1px solid var(--ks-ground-seam);-webkit-overflow-scrolling:touch;}
#ksr-results .ksr-year-btn{width:auto;flex:none;padding:12px 16px;border-bottom:none;border-right:1px solid var(--ks-ground-seam);white-space:nowrap;font-size:17px;}
#ksr-results .ksr-year-btn:last-child{border-right:none;}
#ksr-results .ksr-year-btn.active{box-shadow:inset 0 -3px 0 var(--ks-grid-light-green);}
#ksr-results .ksr-season-head,#ksr-results .ksr-col-head{padding-left:14px;padding-right:14px;}
#ksr-results .ksr-row{padding:10px 14px;}
#ksr-results .ksr-event-name{font-size:14px;}
#ksr-results .ksr-event-sub{font-size:12px;}
#ksr-results .ksr-links{font-size:12.5px;}
#ksr-results .ksr-dl{display:none;}
#ksr-results .ksr-ds{display:inline;}
#ksr-results .ksr-cal-row{gap:12px;}
}
</style>
<noscript><style>#ksr-results .ksr-season{display:block;}#ksr-results .ksr-years{display:none;}</style></noscript>"""

SCRIPT = """<script>
(function(){
var root=document.getElementById('ksr-results');if(!root)return;
var btns=root.querySelectorAll('.ksr-year-btn'),panels=root.querySelectorAll('.ksr-season');
function show(y,push){
var found=false;
panels.forEach(function(p){var on=p.getAttribute('data-year')===y;p.classList.toggle('active',on);if(on)found=true;});
if(!found)return false;
btns.forEach(function(b){b.classList.toggle('active',b.getAttribute('data-year')===y);b.setAttribute('aria-selected',b.getAttribute('data-year')===y?'true':'false');});
if(push&&history.replaceState){history.replaceState(null,'','#'+y);}
var ab=root.querySelector('.ksr-year-btn.active');if(ab&&ab.scrollIntoView){ab.scrollIntoView({block:'nearest',inline:'nearest'});}
return true;
}
btns.forEach(function(b){b.addEventListener('click',function(){show(b.getAttribute('data-year'),true);});});
var h=(location.hash||'').replace('#','');
if(!(h&&show(h,false))){show(btns[0].getAttribute('data-year'),false);}
window.addEventListener('hashchange',function(){var y=(location.hash||'').replace('#','');if(y)show(y,false);});
})();
</script>"""


def esc(s):
    return html.escape(s, quote=True)


def render_row(row):
    """One event row. A row with no links is an event that has happened but
    whose results are not posted yet -- it still gets a row, marked pending,
    so the season reads as complete."""
    if not row["links"]:
        links_html = '<span class="ksr-pending">Results pending</span>'
        return (
            f'<div class="ksr-row"><div class="ksr-event-name">{esc(row["title"])}</div>'
            f'<div class="ksr-meta"><div class="ksr-event-sub">{esc(row.get("date", ""))}</div>'
            f'<div class="ksr-links">{links_html}</div></div></div>'
        )
    links = []
    for i, (label, href) in enumerate(row["links"]):
        if i:
            links.append('<span class="ksr-sep"> &middot; </span>')
        ext = ' target="_blank" rel="noopener"' if href.startswith("http") else ""
        links.append(f'<a class="ksr-link" href="{esc(href)}"{ext}>{esc(label)}</a>')
    sub = f'<div class="ksr-event-sub">{esc(row["date"])}</div>' if row.get("date") else '<div class="ksr-event-sub"></div>'
    return (
        f'<div class="ksr-row"><div class="ksr-event-name">{esc(row["title"])}</div>'
        f'<div class="ksr-meta">{sub}<div class="ksr-links">{"".join(links)}</div></div></div>'
    )


def season_points(rows):
    """The season's standings links, if that season has any.

    They are recorded inside the season in the JSON, on a row titled
    "Season Points", so a link is written down in exactly one place. This
    reads them back out; the row itself is not rendered as an event.
    """
    for r in rows:
        if r["title"] == "Season Points" and r["links"]:
            return r["links"]
    return None


def event_day(row):
    """'June 27, 2026' -> date, or None for anything that is not one day."""
    try:
        return datetime.strptime(row.get("date", ""), "%B %d, %Y").date()
    except ValueError:
        return None


def render_cal_row(row):
    """A current-season results row with a calendar leaf, in the markup the
    ksscca_season_rows shortcode uses for events that have not run yet, so the
    two read as one list."""
    day = event_day(row)
    inner = render_row(row)
    leaf = ('<div class="ksr-cal" aria-hidden="true"><span class="ksr-cal-m">%s</span>'
            '<span class="ksr-cal-d">%d</span></div>' % (day.strftime("%b").upper(), day.day))
    body = inner[len('<div class="ksr-row">'):-len("</div>")]
    body = body.replace(f'<div class="ksr-event-sub">{esc(row["date"])}</div>',
                        f'<div class="ksr-event-sub"><span class="ksr-dl">{day.strftime("%A")}</span>'
                        f'<span class="ksr-ds">{day.strftime("%a")}</span>, {day.strftime("%B")} {day.day}</div>')
    return f'<div class="ksr-row ksr-cal-row">{leaf}<div class="ksr-cal-main">{body}</div></div>'


def render(data, schedule=False):
    years = sorted(data["seasons"].keys(), reverse=True)
    disc = data["discipline"]
    sched = data.get("schedule_page") or {}
    page_id = sched["page_id"] if schedule else data["page_id"]
    out = [STYLE.replace("PAGE_ID", str(page_id)), ""]
    out.append('<div id="ksr-results">')
    # Small eyebrow line carries the full page name (it is the page's H1 for
    # search engines, styled at H6 size); the visible section headings are H2s
    # with the same inline treatment as the homepage's "Upcoming Events" H1.
    out.append(f'<h1 class="ksr-eyebrow">{esc(sched["title"] if schedule else data["title"])}</h1>')
    intro = sched.get("intro") if schedule else data.get("intro")
    if intro:
        out.append(f'<p class="ksr-intro">{esc(intro)}</p>')

    current = data.get("current") or {}
    season = current.get("season", "")
    rows = current.get("rows") or []
    # The current season's standings are a button on the heading rather than a
    # row: they are one link, and they are what someone tracking a championship
    # comes back for. Seasons that have not posted standings yet still show the
    # control, inert and explained, so the page does not simply omit the thing
    # they were looking for.
    # A season in progress has no archive entry yet, so its standings link
    # lives on "current" itself; once the season is archived, its Season Points
    # row takes over.
    cur_points = current.get("points") or season_points(data["seasons"].get(season, []))
    if cur_points:
        href, label = cur_points[0][1], "Season points"
        btn = f'<a class="ksr-btn" href="{esc(href)}">{label}</a>'
    else:
        btn = ('<span class="ksr-btn is-off" role="link" aria-disabled="true" '
               f'title="Standings for the {esc(season)} season are posted once the season ends.">'
               'Season points</span>')
    if schedule:
        out.append(f'<div class="ksr-head"><h2 class="ksr-h">Current Season</h2>{btn}</div>')
        out.append('<div class="ksr-current">')
        out.append(f'<div class="ksr-season-head">{esc(season)} {esc(disc)} Season</div>')
        out.append('<div class="ksr-col-head"><span>Event</span><span></span></div>')
        # One list in calendar order: what has run, with its results, then
        # what is coming. The upcoming rows come from the live MotorsportReg
        # feed at request time, drawn by the shortcode in the same markup.
        dated = [r for r in rows if event_day(r)]
        for r in dated:
            out.append(render_cal_row(r))
        after = max(event_day(r) for r in dated).isoformat() if dated else ""
        out.append(f'[ksscca_season_rows type="{esc(sched["feed_type"])}" after="{after}"]')
        out.append("</div>")
        return "\n".join(out + archive(data, years, disc)) + "\n"
    out.append(f'<div class="ksr-head"><h2 class="ksr-h">Current Results</h2>{btn}</div>')
    out.append('<div class="ksr-current">')
    n = len(rows)
    label = f'{n} event{"s" if n != 1 else ""}' if n else "no results posted yet"
    out.append(f'<div class="ksr-season-head">{esc(season)} {esc(disc)} Season &middot; {label}</div>')
    if rows:
        out.append('<div class="ksr-col-head"><span>Event</span><span>Results</span></div>')
        # Current season reads newest first -- the most recent event is what a
        # visitor came for. The archive below stays in calendar order.
        for r in reversed(rows):
            out.append(render_row(r))
    else:
        out.append('<div class="ksr-na">NA</div>')
    out.append("</div>")
    return "\n".join(out + archive(data, years, disc)) + "\n"


def archive(data, years, disc):
    out = []
    out.append('<h2 class="ksr-h">Results Archive</h2>')
    out.append('<div class="ksr-layout">')
    nav = "".join(
        f'<button type="button" class="ksr-year-btn{" active" if i == 0 else ""}" data-year="{y}" role="tab" aria-selected="{"true" if i == 0 else "false"}">{y}</button>'
        for i, y in enumerate(years)
    )
    out.append(f'<nav class="ksr-years" role="tablist" aria-label="Season">{nav}</nav>')
    out.append('<div class="ksr-panel">')
    for i, y in enumerate(years):
        rows = data["seasons"][y]
        n = sum(1 for r in rows if r["title"] != "Season Points")
        out.append(f'<section class="ksr-season{" active" if i == 0 else ""}" data-year="{y}" id="season-{y}" role="tabpanel">')
        out.append(f'<div class="ksr-season-head">{y} {esc(disc)} Results &middot; {n} event{"s" if n != 1 else ""}</div>')
        pts = season_points(rows)
        if pts:
            # One link is the season's standings and says so; several are the
            # cuts of them (Class, PAX) and keep their own names.
            btns = "".join(
                f'<a class="ksr-btn" href="{esc(href)}">'
                f'{esc("Season points" if len(pts) == 1 else label)}</a>'
                for label, href in pts
            )
            out.append('<div class="ksr-points">')
            out.append('<div class="ksr-col-head"><span>Season points</span><span>Standings</span></div>')
            # "Final" is safe here: every season in the archive is a past
            # season, and a season tally from a past year is its last word,
            # whatever the export happens to be named.
            out.append(f'<div class="ksr-row ksr-prow"><div class="ksr-event-name">{y} final standings</div>'
                       f'<div class="ksr-meta"><div class="ksr-links">{btns}</div></div></div>')
            out.append("</div>")
        out.append('<div class="ksr-col-head"><span>Event</span><span>Results</span></div>')
        for r in rows:
            if r["title"] == "Season Points":
                continue
            out.append(render_row(r))
        out.append("</section>")
    out.append("</div></div>")  # .ksr-panel, .ksr-layout
    out.append("</div>")  # #ksr-results
    out.append(SCRIPT)
    return out


def main():
    args = [a for a in sys.argv[1:] if a != "--schedule"]
    if len(args) != 1:
        sys.exit(__doc__)
    data = json.loads(Path(args[0]).read_text())
    sys.stdout.write(render(data, schedule="--schedule" in sys.argv))


if __name__ == "__main__":
    main()
