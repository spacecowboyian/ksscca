#!/usr/bin/env python3
"""Render one event's Class, PAX and Raw results as a single standalone page.

    bin/build-event-page results/events/2026-06-27-comeback-1.json --out results/build/

One file comes out, with the three views as tabs. It is uploaded to the Media
Library and served straight off disk, so it cannot use the site's token snippet
and carries its own copy of the palette. The look follows the Solo Nationals
page.

The archive still links all three views: each tab has a fragment, and the page
opens on whichever one the link names. With JavaScript off every view is simply
shown in turn, so the results are never hidden behind a control that cannot
run.

Input is the canonical event JSON: one entry per driver with the run strings as
the timing system printed them. Everything else is derived here, so the two
rankings cannot drift from the class results the way separately transcribed
sheets would.
"""
import argparse, html, json, re
from pathlib import Path

E = lambda s: html.escape(str(s), quote=True)

# PAX index for this season, by class.
FACTOR = {
    "ast": 1.000, "bst": 1.000, "cst": 1.000, "cstl": 1.000, "dst": 1.000,
    "est": 1.000, "gst": 1.000, "am": 1.000, "rx": 1.000,
    "hs": 0.786, "hsl": 0.786, "es": 0.792, "esl": 0.792, "gs": 0.796,
    "csm": 0.808, "ds": 0.810, "csx": 0.811, "cs": 0.813, "fs": 0.814,
    "bs": 0.818, "camt": 0.820, "as": 0.824, "camc": 0.826, "fsp": 0.831,
    "evx": 0.834, "ss": 0.835, "xa": 0.844, "cams": 0.848, "camsl": 0.848,
    "xb": 0.849, "xbl": 0.849, "smf": 0.850, "cp": 0.856, "ep": 0.858,
    "csp": 0.860, "sm": 0.868, "xu": 0.869, "fm": 0.917, "fsae": 0.980,
}

