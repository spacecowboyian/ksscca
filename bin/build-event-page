RUN = re.compile(r"^([\d.]+)(?:\+(?:(\d+)?(?:/(\d+))?|dnf))?$")


def parse_run(run, pen):
    """One run, as the timing system printed it.

    "53.067+1" is a run with a cone; "45.372+0/1" adds a missed gate;
    "87.714+dnf" did not finish. Penalty seconds come from the event, because
    a cone is worth two seconds in autocross and a gate ten in RallyCross.
    """
    run = (run or "").strip()
    if not run:
        return None
    dnf = "dnf" in run
    m = RUN.match(run)
    if not m:
        return None
    time = float(m.group(1))
    cones = int(m.group(2) or 0)
    gates = int(m.group(3) or 0)
    seconds = cones * pen["cone_seconds"] + gates * pen["gate_seconds"]
    if dnf:
        # the event's own adjustment, once. dnf_cones describes that adjustment
        # in cones for the paperwork; charging both double counts it.
        seconds += pen.get("dnf_seconds", 0)
    return {"raw": run, "time": time, "cones": cones, "gates": gates,
            "dnf": dnf, "total": time + seconds, "penalty": seconds}


def counted(run, pen=None):
    """What a run scored. A dnf scores nothing under best-run scoring."""
    pen = pen or DEFAULT_PENALTIES
    r = parse_run(run, pen)
    if r is None or r["dnf"]:
        return None
    return r["total"]


DEFAULT_PENALTIES = {"cone_seconds": 2.0, "gate_seconds": 10.0,
                     "dnf_cones": 0, "dnf_seconds": 0}


def best(runs, pen=None):
    vals = [v for v in (counted(r, pen) for r in runs) if v is not None]
    return min(vals) if vals else None


def summed(runs, pen):
    """RallyCross adds every run up, penalties included, and a run that did
    not finish still counts: it carries its own adjustment instead."""
    parsed = [parse_run(r, pen) for r in runs]
    parsed = [r for r in parsed if r is not None]
    return sum(r["total"] for r in parsed) if parsed else None


def factor(entry):
    return FACTOR[entry.get("base") or entry["cls"]]


def raw_total(entry, event=None):
    """What the driver actually drove, before any index.

    Autocross scores the best single run; RallyCross adds every run up. For an
    autocross novice this is not the printed total, which is already indexed.
    """
    pen = (event or {}).get("penalties", DEFAULT_PENALTIES)
    if (event or {}).get("scoring") == "sum":
        return summed(entry["runs"], pen)
    return best(entry["runs"], pen)


def pax_time(entry, event=None):
    r = raw_total(entry, event)
    return None if r is None else round(r * factor(entry), 3)


NAME_PARTICLES = {"von", "van", "de", "del", "della", "di", "da", "la", "le"}


def cap_name(name):
    """Capitalise a name the entry list typed in lower case.

    Only words that are entirely lower case are touched, so McCormack,
    LaRandeau and DeLay keep the shape their owners use. A particle keeps its
    lower case unless it starts the name: von Bevern, not Von Bevern.
    """
    out = []
    for i, w in enumerate(name.split(" ")):
        if not w:
            continue
        if w != w.lower() or (i and w in NAME_PARTICLES):
            out.append(w)
        else:
            out.append(w[:1].upper() + w[1:])
    return " ".join(out)


def run_cells(entry, event):
    """The runs as row cells, for screens wide enough to carry them."""
    mark = None if event.get("scoring") == "sum" else best(entry["runs"], event.get("penalties"))
    out = []
    for r in entry["runs"]:
        v = counted(r)
        if not (r or "").strip():
            out.append('<span class="t rc m">&mdash;</span>')
        elif v is not None and mark is not None and abs(v - mark) < 0.0005:
            out.append(f'<span class="t rc b">{E(r)}</span>')
        else:
            out.append(f'<span class="t rc">{E(r)}</span>')
    return "".join(out)


def extremes(entry, event):
    """A RallyCross driver's quickest and slowest runs, as the timing system
    printed them. Penalties decide the order, so a clean 66 beats a 65 with a
    cone. A run that did not finish cannot be the quickest, but it counted, so
    it can be the slowest."""
    pen = event.get("penalties", DEFAULT_PENALTIES)
    rs = [r for r in (parse_run(x, pen) for x in entry["runs"]) if r is not None]
    finished = [r for r in rs if not r["dnf"]]
    fast = min(finished, key=lambda r: r["total"])["raw"] if finished else None
    slow = max(rs, key=lambda r: r["total"])["raw"] if rs else None
    return fast, slow


def extreme_cells(entry, event):
    fast, slow = extremes(entry, event)
    cell = lambda v, c: (f'<span class="t {c}">{E(v)}</span>' if v
                         else f'<span class="t m {c}">&mdash;</span>')
    return cell(slow, "c-slow") + cell(fast, "c-fast")


def run_boxes(entry, event):
    """The runs, as labelled boxes. Under best-run scoring the one that counted
    is marked; under sum scoring they all count, so none is."""
    mark = None if event.get("scoring") == "sum" else best(entry["runs"], event.get("penalties"))
    out = []
    for i, r in enumerate(entry["runs"], 1):
        v = counted(r)
        txt = E(r) if (r or "").strip() else "&mdash;"
        cls = "run best" if (v is not None and mark is not None and abs(v - mark) < 0.0005) else "run"
        if not (r or "").strip():
            cls = "run m"
        out.append(f'<div class="{cls}"><span>Run {i}</span>{txt}</div>')
    return '<div class="runs">%s</div>' % "".join(out)


def info_list(pairs):
    return '<div class="info">%s</div>' % "".join(
        f"<div><b>{E(k)}</b>{E(v) if v else '&mdash;'}</div>" for k, v in pairs)


ALL_VIEWS = (("class", "Class"), ("pax", "PAX index"), ("raw", "Raw time"))

TABS = """<script>
(function(){var r=document.documentElement;r.className+=' js';
function show(k){var ok=false;VIEWS.forEach(function(v){var s=document.getElementById('view-'+v);
var b=document.getElementById('tab-'+v);if(!s||!b){return;}var on=v===k;s.hidden=!on;
b.className='view'+(on?' on':'');b.setAttribute('aria-selected',on?'true':'false');if(on){ok=true;}});
return ok;}
