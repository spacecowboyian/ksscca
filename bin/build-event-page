if(!reduced.matches){timer=setInterval(step,4000);}
['pointerdown','wheel','touchstart','keydown'].forEach(function(ev){
strip.addEventListener(ev,stop,{passive:true});});
/* a mouse can drag it too, not just a trackpad or a thumb */
var down=false,x0=0,left0=0;
strip.addEventListener('pointerdown',function(e){if(e.pointerType==='mouse'){down=true;
x0=e.clientX;left0=strip.scrollLeft;strip.classList.add('dragging');
strip.setPointerCapture(e.pointerId);}});
strip.addEventListener('pointermove',function(e){if(!down){return;}
strip.scrollLeft=left0-(e.clientX-x0);});
function release(){down=false;strip.classList.remove('dragging');}
