VIEWS.forEach(function(v){var b=document.getElementById('tab-'+v);if(b){b.addEventListener('click',
function(e){e.preventDefault();location.hash=v;show(v);});}});
addEventListener('hashchange',function(){show(fromHash());});show(fromHash());
/* The tiles ride a strip that steps itself along every four seconds so all
   eight get seen without anyone having to find the drag. Any hand on it -
   drag, wheel, touch or keyboard - stops the stepping for good: a strip that
   keeps moving under your finger is worse than one that never moved. */
