}
var pick=document.getElementById('class-pick');
if(pick){var mods=[].slice.call(document.querySelectorAll('#view-class .mod'));
pick.addEventListener('change',function(){var v=pick.value;
mods.forEach(function(m){var c=m.getAttribute('data-cls');
m.hidden=!(v==='all'||c===v);});});}
})();
</script>"""


def shell(title, event, sections):
    wanted = event.get("views") or [k for k, _ in ALL_VIEWS]
    views_list = [(k, label) for k, label in ALL_VIEWS if k in wanted]
    views = "".join(
        '<a class="view%s" id="tab-%s" href="#%s" role="tab" aria-selected="%s">%s</a>'
        % (" on" if k == "class" else "", k, k, "true" if k == "class" else "false", label)
        for k, label in views_list
    )
    body = "".join(
        f'<section id="view-{k}" class="view-pane"><h2 class="pane-h">{E(label)} results</h2>{sections[k]}</section>'
        for k, label in views_list
    )
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{E(title)} &mdash; {E(event['name'])}, {E(event['date'])}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=PT+Sans+Narrow:wght@400;700&display=swap" rel="stylesheet">
{STYLE}
<style>{runs_css(event)}</style></head><body><div class="wrap">
<div class="head"><p class="kicker">{E(event['org'])} {E(event['event_no'])}</p>
<h1>{E(event['name'])}</h1>
<p class="sub">{E(event['date'])} &middot; {event['registered']} registered, {event['with_times']} with times</p>
<div class="views" role="tablist">{views}</div></div>
{tiles(event)}
{body}
<div class="foot">Timing by AXWare Systems. Results generated {E(event['generated'])}.
Posted by Kansas Region SCCA.</div>
</div>{TABS}</body></html>
"""


def runs_css(event):
    """Show the runs on the row only where they actually fit.

    A day can be three runs or fifteen, so the width at which they earn their
    place moves with the count rather than sitting at one breakpoint. Below it
    the runs stay in the expansion, which is where they always were.
    """
    if event.get("scoring") == "sum":
        return ("@media(min-width:621px){"
                ":root{--c-class:46px minmax(0,1fr) 96px 96px 86px 76px;"
                "--c-rank:52px minmax(0,1fr) 56px 96px 96px 86px 76px;}"
                "}")
    n = run_count(event)
    # size the column to the widest run this event actually printed rather than
    # to a guess: "53.067+1" needs 67px at 14px, and a clipped run time is
    # worse than no run time.
    lens = sorted(len(r) for e in event["entries"] for r in e["runs"] if r)
    # the ninetieth percentile, not the longest: one "45.372+0/1" should not
    # set the width of every column for the day. The columns can grow into
    # spare space, so a rare long one still fits.
    p90 = lens[int(len(lens) * 0.9)] if lens else 6
    size = 13 if n > 6 else 14
    w = max(52, int(p90 * size * 0.62) + 10)
    need = 46 + 210 + (n * (w + 10)) + 72 + 86 + 60   # pos, name, runs, diff, best, chrome
    return ("@media(min-width:%dpx){"
            ":root{--c-class:46px minmax(0,1fr) repeat(%d,minmax(%dpx,max-content)) 72px 86px;}"
            ".class .rc{display:block;font-size:%dpx;}"
            ".class .runs{display:none;}"
            "}" % (need, n, w, size))


def run_count(event):
    return max(len(e["runs"]) for e in event["entries"])


def score_label(event):
    """A sum of nine runs is a total; a single counted run is a best."""
    return "Total" if event.get("scoring") == "sum" else "Best"


def ordinal(n):
    return "%d%s" % (n, "th" if 10 <= n % 100 <= 20 else {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th"))


def tiles(event):
    """The half dozen things worth noticing that a results table does not say.

    Every one is computed from this event's own numbers, so they hold for any
    event rather than being written once and going stale. What counts as clean
    differs by discipline: RallyCross has gates and did-not-finish adjustments
    to avoid as well, autocross only has cones.
    """
    pen = event.get("penalties", DEFAULT_PENALTIES)
    summing = event.get("scoring") == "sum"
    indexed = not summing
    names = event["class_names"]
    ents = [e for e in event["entries"] if e["total"] not in ("dns", "dnf")
            and raw_total(e, event) is not None]
    if not ents:
        return ""

    def runs_of(e):
        return [r for r in (parse_run(x, pen) for x in e["runs"]) if r]

    def total_of(e):
        """The number the class was decided on, which for an autocross novice
        is their indexed time, not the raw one. Comparing a novice's raw time
        against their class made the closest fight come out negative."""
        try:
            return float(e["total"])
        except (TypeError, ValueError):
            return raw_total(e, event)

    def cname(e):
        return names.get(e["cls"], e["cls"].upper())

    out = []
    def add(k, name, fig, sub_):
        out.append((k, name, fig, sub_))

    # fastest of the day, before class or index has a say
    quickest = min(ents, key=lambda e: raw_total(e, event))
    add("Fastest raw time" if not summing else "Fastest total",
        cap_name(quickest["name"]), "%.3f" % raw_total(quickest, event), cname(quickest))

    # second under a sum, where the day's total says nothing about how quick
    # anyone actually was on one lap. Autocross gives this slot to the index,
    # which is the same question asked a different way.
    if summing:
        quick = None
        for e in ents:
            for r in runs_of(e):
                if not r["dnf"] and (quick is None or r["total"] < quick[0]):
                    quick = (r["total"], e)
        if quick:
            add("Quickest single run", cap_name(quick[1]["name"]), "%.3f" % quick[0],
                cname(quick[1]))

    # the index winner: the fastest car relative to what its class should do
    if indexed:
        paxed = [e for e in ents if e["cls"] != "n"]
        if paxed:
            top = min(paxed, key=lambda e: pax_time(e, event))
            add("Top PAX", cap_name(top["name"]), "%.3f" % pax_time(top, event),
                "%s \u00b7 %.3f raw" % (cname(top), total_of(top)))

    # the class that came down to the least
    by_class = {}
    for e in ents:
        by_class.setdefault(e["cls"], []).append(e)
    close = None
    for cls, rows in by_class.items():
        rows = sorted(rows, key=lambda r: r["pos"])
        if len(rows) < 2:
            continue
        margin = total_of(rows[1]) - total_of(rows[0])
        if close is None or margin < close[0]:
            close = (margin, cls, rows[0], rows[1])
    if close:
        add("Closest fight", cap_name(close[2]["name"]), "%.3f" % close[0],
            "%s \u00b7 over %s" % (names.get(close[1], close[1].upper()),
                                   cap_name(close[3]["name"])))

    # the run that was quick enough and came home with a cone on it
    ghost = None
    for e in ents:
        rs = runs_of(e)
        penalised = [r for r in rs if r["penalty"] > 0]
        if not penalised:
            continue
        if summing:
            # every run counts, so a clean day is the total less its penalties
            clean = total_of(e) - sum(r["penalty"] for r in rs)
        else:
            # only one run counts, so it is the quickest run that carried a
            # penalty, had it come home clean
            clean = min(r["time"] for r in penalised if not r["dnf"]) if any(
                not r["dnf"] for r in penalised) else None
        if clean is None:
            continue
        lost = total_of(e) - clean
        if lost <= 0:
            continue
        # the highest place that clean total would have taken, and who from
        grid = sorted(by_class[e["cls"]], key=total_of)
        here = grid.index(e)
        took = next((j for j in range(here) if clean < total_of(grid[j])), None)
        if took is None:
            continue
        rival = grid[took]
        key = (took == 0, here - took, lost)
        if ghost is None or key > ghost[0]:
            ghost = (key, e, clean, rival, took + 1)
    if ghost:
        _, e, clean, rival, place = ghost
        # the figure is what the title is about: how far ahead of the driver
        # above them a clean day would have finished
        add("One clean run away", cap_name(e["name"]), "%.3f" % (total_of(rival) - clean),
            "%s \u00b7 clean, %.3f beats %s's %.3f for %s" % (
                cname(e), clean, cap_name(rival["name"]), total_of(rival), ordinal(place)))

    # the steadiest driver: the smallest spread across every run they took.
    # Clock times, cones and gates aside, since a penalty is a mistake rather
    # than a slower lap. Only drivers who finished every run of the day count,
    # or two tidy runs and a dns would beat nine.
    full = max(len(e["runs"]) for e in ents)
    steady = []
    for e in ents:
        rs = runs_of(e)
        if len(rs) < max(3, full) or any(r["dnf"] for r in rs):
            continue
        times = [r["time"] for r in rs]
        mean = sum(times) / len(times)
        sd = (sum((t - mean) ** 2 for t in times) / len(times)) ** 0.5
        steady.append((sd, min(times), max(times), e))
    if steady:
        sd, lo, hi, e = min(steady, key=lambda x: x[0])
        add("Most consistent", cap_name(e["name"]), "\u00b1%.3f" % sd,
            "%s \u00b7 %d runs, all between %.3f and %.3f" % (cname(e), len(e["runs"]), lo, hi))

    # the newcomers' race within the race
    novices = by_class.get("n") or []
    if novices:
        n1 = min(novices, key=total_of)
        sub_ = "%d out%s" % (len(novices), ", scored on index" if indexed else "")
        add("Novice win", cap_name(n1["name"]), "%.3f" % total_of(n1), sub_)

    # the quickest driver who kept it clean all day
    def clean_all(e):
        rs = runs_of(e)
        if not rs:
            return False
        if summing:
            return all(r["penalty"] == 0 and not r["dnf"] for r in rs)
        return all(r["cones"] == 0 for r in rs)
    spotless = [e for e in ents if clean_all(e)]
    if spotless:
        # pace, not placing: compare what they drove, so an indexed novice is
        # not measured against everyone else's raw time
        b = min(spotless, key=lambda e: raw_total(e, event))
        add("Fastest clean all day", cap_name(b["name"]), "%.3f" % raw_total(b, event),
            "%s \u00b7 %s" % (cname(b), "no penalties in %d runs" % len(runs_of(b)) if summing
                              else "not a cone all day"))

    # what the cones cost everyone between them
    cones = sum(r["cones"] for e in ents for r in runs_of(e))
    gates = sum(r["gates"] for e in ents for r in runs_of(e))
    dnfs = sum(1 for e in ents for r in runs_of(e) if r["dnf"])
    secs = sum(r["penalty"] for e in ents for r in runs_of(e))
    if cones or gates or dnfs:
        bits = []
        if cones:
            bits.append("%d cone%s" % (cones, "" if cones == 1 else "s"))
        if gates:
            bits.append("%d gate%s" % (gates, "" if gates == 1 else "s"))
        if dnfs:
            bits.append("%d DNF" % dnfs)
        # not just cones: gates and did-not-finish adjustments land here too,
        # so the label says what the figure actually adds up
        add("Penalty time", None, "+%.3f" % secs, " \u00b7 ".join(bits))

    cells = []
    for k, name, fig, sub_ in out[:8]:
        who = f'<span class="tn">{E(name)}</span>' if name else ""
        cells.append(f'<div class="tile"><div class="tk">{E(k)}</div>'
                     f'<div class="tv">{who}<span class="tf">{fig}</span></div>'
                     f'<div class="ts">{E(sub_)}</div></div>')
    return '<div class="tiles">%s</div>' % "".join(cells)


def class_page(event):
    by_class = {}
    for e in event["entries"]:
        by_class.setdefault(e["cls"], []).append(e)

    # Forty classes is a long scroll when you came to read one of them. The
    # control only appears with script running, since it is the script that
    # makes it do anything.
    summing = event.get("scoring") == "sum"
    present = [c for c in event["class_order"] if by_class.get(c)]
    opts = "".join(
        f'<option value="{E(c)}">{E(c.upper())} &middot; {E(event["class_names"][c])}'
        f' ({len(by_class[c])})</option>' for c in present)
    out = ['<div class="filter"><label for="class-pick">Show</label>'
           f'<select id="class-pick"><option value="all">All classes '
           f'({len(present)})</option>{opts}</select></div>']
    for cls in event["class_order"]:
        rows = sorted(by_class.get(cls, []), key=lambda r: r["pos"])
        if not rows:
            continue
        # autocross scores its novice class on index; a RallyCross novice is
        # simply a novice, and their total is a sum like everyone else's
        indexed = cls == "n" and event.get("scoring") != "sum"
        out.append(f'<div class="mod class" data-cls="{E(cls)}"><div class="mh">'
                   f'<div class="mt">{E(cls.upper())} &middot; {E(event["class_names"][cls])}</div>'
                   f'<div class="mn">{len(rows)} entr{"y" if len(rows)==1 else "ies"}'
                   f'{" &middot; scored on index" if indexed else ""}</div></div>')
        if summing:
            # RallyCross reads the same in every view: the slowest run, the
            # quickest, what they added up to, and the gap. The runs themselves
            # are a click away.
            out.append('<div class="hdr"><span class="c-pos">Pos</span>'
                       '<span class="c-who">Driver</span>'
                       '<span class="t c-slow">Slowest</span><span class="t c-fast">Fastest</span>'
                       '<span class="t c-best">Total</span><span class="t c-diff">Diff</span></div>')
        else:
            runs_head = "".join(f'<span class="t rc">Run {i}</span>'
                                for i in range(1, run_count(event) + 1))
            out.append('<div class="hdr"><span class="c-pos">Pos</span>'
                       f'<span class="c-who">Driver</span>{runs_head}'
                       f'<span class="t c-diff">Diff</span>'
                       f'<span class="t c-best">{E(score_label(event))}</span></div>')
        for r in rows:
            pos = ('<span class="pos c-pos">%d%s</span>'
                   % (r["pos"], '<span class="tro">T</span>' if r["trophy"] else ""))
            total = r["total"]
            bestc = (f'<span class="m">{E(total)}</span>' if total in ("dns", "dnf")
                     else f'<span class="g">{E(total)}</span>')
            # The class winner has nobody ahead of them. The timing system
            # prints their lead over second here, in a column that otherwise
            # says how far back you are.
            diff = "-" if r["pos"] == 1 else r["diff"]
            who = (f'<span class="who c-who"><span class="nm">{E(cap_name(r["name"]))}</span>'
                   f'<span class="car">{E(r["car"])}</span></span>')
            body = run_boxes(r, event) + info_list([
                ("Driver", cap_name(r["name"])),
                ("Class", (r.get("base") or r["cls"]).upper()),
                ("Car number", r["num"]),
                ("Colour", r["color"]),
                ("Car", r["car"]),
            ])
            if summing:
                cells = (extreme_cells(r, event)
                         + f'<span class="t c-best">{bestc}</span>'
                         + f'<span class="t m c-diff">{E(diff)}</span>')
            else:
                # Best sits on the right in every autocross view, so the time
                # is always in the same place whichever tab you are on.
                cells = (run_cells(r, event)
                         + f'<span class="t m c-diff">{E(diff)}</span>'
                         + f'<span class="t c-best">{bestc}</span>')
            out.append(f'<details class="row"><summary>{pos}{who}{cells}'
                       f'</summary><div class="body">{body}</div></details>')
        out.append("</div>")

    tt = ['<div class="mod" data-cls="_ttod"><div class="mh">'
          '<div class="mt">Top times of day</div></div>']
    for label, time, cls, num, name in event["top_times"]:
        tt.append('<div class="row flat" style="grid-template-columns:minmax(0,1fr) 92px">'
                  f'<span class="who"><span class="nm">{E(label)}</span>'
                  f'<span class="car">{E(cap_name(name))} &middot; {E(cls)} {E(num)}</span></span>'
                  f'<span class="t g">{E(time)}</span></div>')
    tt.append("</div>")

    pen = event.get("penalties", DEFAULT_PENALTIES)
    if event.get("scoring") == "sum":
        note = ('<div class="note"><p><b>How to read this.</b> Tap a driver for their runs. '
                'Every run counts: the total is all of them added up, penalties included. '
                'A number after a run is cones at %g seconds each, and a second number after a '
                'slash is missed gates at %g. <b>dnf</b> is a run that did not finish and carries '
                'a %g second adjustment rather than being thrown away. <b>T</b> marks a trophy '
                'position.</p>%s</div>'
                % (pen["cone_seconds"], pen["gate_seconds"], pen.get("dnf_seconds", 0),
                   ("<p>%s</p>" % E(event["note"])) if event.get("note") else ""))
    else:
        note = ('<div class="note"><p><b>How to read this.</b> Tap a driver for their runs. '
                'Only the best one counts. A number after a run is cones, %g seconds each, '
                'already included in the best. <b>dnf</b> is a run that did not finish and '
                'scores nothing. <b>T</b> marks a trophy position. Novice is scored on index, '
                'so its figures are PAX times rather than raw.</p></div>'
                % pen["cone_seconds"])
    return "".join(out) + "".join(tt) + note


def ranked_page(event, kind):
    # A driver can have run times and still not be scored: Grant Tabler took
    # four runs here and the timing system recorded him dns. The printed
    # total decides, not the presence of times.
    scored = [e for e in event["entries"]
              if e["total"] not in ("dns", "dnf") and raw_total(e, event) is not None]
    if kind == "pax":
        scored.sort(key=lambda e: pax_time(e, event))
        title = "PAX index results"
        cols = ["Pos", "Driver", "Class", "Best", "Index", "Pax time"]
    else:
        scored.sort(key=lambda e: raw_total(e, event))
        title = "Raw time results"
        cols = ["Pos", "Driver", "Class", "Diff", "From 1st", "Best"]
    summing = kind == "raw" and event.get("scoring") == "sum"
    if summing:
        cols = ["Pos", "Driver", "Class", "Slowest", "Fastest", "Total", "Diff"]
    leader = pax_time(scored[0], event) if kind == "pax" else raw_total(scored[0], event)

    out = [f'<div class="mod rank {kind}"><div class="mh"><div class="mt">{E(title)}</div>'
           f'<div class="mn">{len(scored)} timed entries</div></div>']
    out.append('<div class="hdr">%s</div>' % "".join(
        f'<span{" class=\"t\"" if i > 2 else ""}>{E(c)}</span>' for i, c in enumerate(cols)))
    prev = None
    for i, e in enumerate(scored, 1):
        value = pax_time(e, event) if kind == "pax" else raw_total(e, event)
        cls = ("n" if e["cls"] == "n" else "") + (e.get("base") or e["cls"])
        who = (f'<span class="who"><span class="nm">{E(cap_name(e["name"]))}</span>'
               f'<span class="car">{E(e["car"])} &middot; #{E(e["num"])}</span></span>')
        gap = ""
        best_cell = ('<span class="t%s">%s</span>'
                     % ("" if kind == "pax" else " g", "%.3f" % raw_total(e, event)))
        if kind == "pax":
            rest = (best_cell
                    + f'<span class="t m">{factor(e):.3f}</span>'
                    + f'<span class="t g">{"%.3f" % value}</span>')
        elif summing:
            gap = "" if prev is None else "%.3f" % (value - prev)
            rest = (extreme_cells(e, event) + best_cell
                    + f'<span class="t m">{E(gap or "-")}</span>')
        else:
            gap = "" if prev is None else "%.3f" % (value - prev)
            rest = (f'<span class="t m">{E(gap)}</span>'
                    + f'<span class="t m">{"%.3f" % (value - leader)}</span>'
                    + best_cell)
        # Both ranked views read like the class view on a phone: position,
        # driver, the number they are ranked on. The workings are a tap away.
        common = [("Driver", cap_name(e["name"])), ("Class", cls.upper()), ("Car number", e["num"])]
        if kind == "pax":
            extra = [("Best", "%.3f" % raw_total(e, event)), ("Index", "%.3f" % factor(e))]
        else:
            extra = [("Gap to the car ahead", gap or "-"),
                     ("From 1st", "%.3f" % (value - leader))]
        body = info_list(common + extra + [("Car", e["car"])])
        out.append(f'<details class="row"><summary><span class="pos">{i}</span>{who}'
                   f'<span class="cl">{E(cls)}</span>{rest}</summary>'
                   f'<div class="body">{body}</div></details>')
        prev = value
    out.append("</div>")

    if event.get("scoring") == "sum":
        note = ('<div class="note"><p><b>Total is the raw time</b>, every run added up '
                'with cone and gate penalties included. Slowest and fastest are single runs, '
                'as the timing system printed them. ')
    else:
        note = ('<div class="note"><p><b>Best is the raw time</b>, the driver\'s quickest counted run '
                'with cone penalties included. ')
    if kind == "pax":
        note += ('The PAX time is that best multiplied by the class index, which is how cars in '
                 'different classes are compared. Novice entries carry their own class index.')
    else:
        note += 'Raw time ignores class entirely: it is the stopwatch, nothing else.'
    note += "</p></div>"
    return "".join(out) + note


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("event", type=Path)
    p.add_argument("--out", type=Path, default=Path("results/build"))
    a = p.parse_args()
    event = json.loads(a.event.read_text())
    a.out.mkdir(parents=True, exist_ok=True)
    wanted = event.get("views") or ["class", "pax", "raw"]
    sections = {}
    if "class" in wanted:
        sections["class"] = class_page(event)
    for kind in ("pax", "raw"):
        if kind in wanted:
            sections[kind] = ranked_page(event, kind)
    path = a.out / (a.event.stem + ".htm")
    path.write_text(shell("Results", event, sections))
    print("wrote %s (%d bytes)" % (path, len(path.read_text())))


if __name__ == "__main__":
    main()
