function step(){var t=strip.children[0];var w=t.getBoundingClientRect().width+1;
var end=strip.scrollWidth-strip.clientWidth-2;
strip.scrollTo({left:strip.scrollLeft>=end?0:strip.scrollLeft+w,behavior:'smooth'});}
function stop(){if(stopped){return;}stopped=true;clearInterval(timer);}
