#ksp .ksp-grp-h{font-family:var(--ks-font-display);font-size:19px;font-weight:700;letter-spacing:.02em;color:var(--ks-morning-mist);margin:28px 0 10px;text-align:left;}
#ksp .ksp-grp:first-of-type .ksp-grp-h{margin-top:0;}
#ksp .ksp-cls{border:1px solid var(--ks-ground-seam);margin:0 0 14px;}
#ksp .ksp-cls-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 20px;border-bottom:1px solid var(--ks-ground-seam);}
#ksp .ksp-cls-name{font-weight:600;font-size:14.5px;color:var(--ks-wheat-gold);}
#ksp .ksp-cls-count{font-size:12.5px;color:var(--ks-morning-mist);}
