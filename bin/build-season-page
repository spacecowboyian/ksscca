WP_SCRIPT = """<script>
(function(){var root=document.getElementById('ksp');if(!root)return;root.className+=' js';
var pick=document.getElementById('ksp-pick');if(!pick)return;
pick.addEventListener('change',function(){var v=pick.value;
[].forEach.call(root.querySelectorAll('.ksp-cls'),function(m){m.hidden=!(v==='all'||m.getAttribute('data-cls')===v);});
[].forEach.call(root.querySelectorAll('.ksp-grp'),function(g){g.hidden=![].some.call(g.querySelectorAll('.ksp-cls'),function(m){return !m.hidden;});});});
})();
</script>"""


def short_date(event):
    """'August 23, 2026' -> 'Aug 23', for a column heading."""
    month, day = event["date"].rsplit(",", 1)[0].split()
    return "%s %s" % (month[:3], day)


def wp_row(r, events):
    evs = "".join('<span class="ksp-n ksp-ev-n%s">%s</span>' % ("" if p else " ksp-m", p if p else "&mdash;")
                  for p in r["points"])
    boxes = []
    for event, d in zip(events, r["detail"]):
        if d:
            pos, of, pts = d
            boxes.append(f'<div class="ksp-ev"><b>{E(event["date"])}</b>{ordinal(pos)} of {of} &middot; {pts} pts</div>')
        else:
            boxes.append(f'<div class="ksp-ev is-out"><b>{E(event["date"])}</b>Did not score</div>')
    return (f'<details class="ksp-row"><summary><span class="ksp-pos">{r["place"]}</span>'
            f'<span class="ksp-who"><span class="ksp-nm">{E(cap_name(r["name"]))}</span>'
            f'<span class="ksp-car">{E(r["car"])}</span></span>{evs}'
            f'<span class="ksp-n ksp-tot">{r["counted"]}</span></summary>'
            f'<div class="ksp-body"><div class="ksp-evs">{"".join(boxes)}</div></div></details>')


def wp_page(season, events, by_class):
    order, names = [], {}
    for event in events:
        for c in event["class_order"]:
            if c not in order:
                order.append(c)
        names.update(event["class_names"])
    groups = class_groups(season, [c for c in order if by_class.get(c)])
    n = len(events)
    drivers = len({r["name"].lower() for rows in by_class.values() for r in rows})
    cols = "36px minmax(0,1fr) %s64px" % ("58px " * n)
    heads = "".join(f'<span class="ksp-n" title="{E(e["date"])}">{E(short_date(e))}</span>' for e in events)
    dates = ", ".join(e["date"].rsplit(",", 1)[0] for e in events[:-1])
    dates = (dates + " and " if dates else "") + events[-1]["date"].rsplit(",", 1)[0]
    opts = "".join(
        f'<optgroup label="{E(g)}">' + "".join(
            f'<option value="{E(c)}">{E(c.upper())} &middot; {E(names[c])}</option>' for c in members)
        + "</optgroup>" for g, members in groups)
    out = [WP_STYLE.replace("PAGE_ID", str(season["page_id"])), "",
           f'<div id="ksp" style="--ksp-cols:{cols}">',
           f'<h1 class="ksp-eyebrow">{E(season["page_title"])}</h1>',
           f'<p class="ksp-intro">{E(season["season"])} standings after {n} event{"" if n == 1 else "s"} '
           f'({E(dates)}), {drivers} drivers scored. Tap a driver for their results at each event.</p>',
           f'<div class="ksp-head"><h2 class="ksp-h">{E(season["season"])} Season</h2>'
           f'<div class="ksp-filter"><label for="ksp-pick">Show</label><select id="ksp-pick">'
           f'<option value="all">All classes</option>{opts}</select></div></div>']
    for g, members in groups:
        out.append(f'<div class="ksp-grp"><h3 class="ksp-grp-h">{E(g)}</h3>')
        for c in members:
            rows = by_class[c]
            out.append(f'<div class="ksp-cls" data-cls="{E(c)}"><div class="ksp-cls-head">'
                       f'<div class="ksp-cls-name">{E(c.upper())} &middot; {E(names[c])}</div>'
                       f'<div class="ksp-cls-count">{len(rows)} driver{"" if len(rows) == 1 else "s"}</div></div>')
            out.append(f'<div class="ksp-cols"><span>Pos</span><span>Driver</span>{heads}'
                       f'<span class="ksp-n">Points</span></div>')
            out.extend(wp_row(r, events) for r in rows)
            out.append("</div>")
        out.append("</div>")
    scale = ", ".join(str(p) for p in season["class_points"])
    after = (", then %d for every place after that" % season["class_points_after"]
             if season.get("class_points_after") else "")
    archive = (f' Final standings for past seasons are in the <a href="{E(season["archive_url"])}">'
               f'results archive</a>.' if season.get("archive_url") else "")
    out.append(f'<div class="ksp-note"><b>How points work.</b> Points go by finishing position in class: '
               f'{scale}{after}. A driver with no time scores nothing, and every event counts.{archive}</div>')
    out.append("</div>")
    out.append(WP_SCRIPT)
    return "\n".join(out) + "\n"


# The class picker hides modules; a group heading with none of its classes left
# showing goes with them.
GROUP_FILTER = """<script>
(function(){var pick=document.getElementById('class-pick');if(!pick){return;}
pick.addEventListener('change',function(){[].forEach.call(document.querySelectorAll('.grp'),function(g){
g.hidden=![].some.call(g.querySelectorAll('.mod'),function(m){return !m.hidden;});});});})();
</script>"""


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("season", type=Path)
    p.add_argument("--out", type=Path, default=Path("results/build"))
    p.add_argument("--wp", action="store_true",
                   help="render in-theme WordPress page content instead of a standalone page")
    a = p.parse_args()
    season = json.loads(a.season.read_text())
    events = [json.loads(Path(f).read_text()) for f in season["events"]]
    by_class, pax = standings(season, events)
    a.out.mkdir(parents=True, exist_ok=True)
    if a.wp:
        path = a.out / (a.season.stem + "-points.html")
        path.write_text(wp_page(season, events, by_class))
    else:
        path = a.out / (a.season.stem + "-points.htm")
        path.write_text(page(season, events, by_class, pax))
    print("wrote %s (%d bytes)" % (path, len(path.read_text())))


if __name__ == "__main__":
    main()
